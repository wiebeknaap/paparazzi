<!DOCTYPE module SYSTEM "module.dtd">
<module name="only_orange" dir ="mav_course_exercise">
  <doc>
    <description>
      Guided obstacle avoider using VISUAL_DETECTION ABI messages.
    </description>
    <define name="ONLY_ORANGE_VISUAL_DETECTION_ID"
            value="ABI_BROADCAST"
            description="Which VISUAL_DETECTION message to receive."/>
  </doc>

  <dep>
    <depends>cv_detect_color_object</depends>
  </dep>

  <header>
    <file name="only_orange.h"/>
  </header>

  <init fun="only_orange_init()"/>
  <periodic fun="only_orange_periodic()" freq="10"/>

  <makefile>
    <file name="only_orange.c"/>
  </makefile>
</module>
